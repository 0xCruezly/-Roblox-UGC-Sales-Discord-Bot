# =========================================================
# KONFIGURASI RAHASIA - JANGAN COMMIT KE GITHUB
# =========================================================

# Cookie .ROBLOSECURITY dari akun Roblox (ambil dari browser)
ROBLOSECURITY_COOKIE="_|WARNING:-DO-NOT-SHARE-THIS.--..."

# ID grup atau user (isi salah satu)
GROUP_ID=419756948
PERSONAL_USER_ID=

# Discord Webhook URL (bisa lebih dari satu, pisahkan dengan koma)
DISCORD_WEBHOOK_URLS="https://discord.com/api/webhooks/...,https://discord.com/api/webhooks/..."

# ID user Discord untuk tag di ringkasan harian (opsional)
DISCORD_USER_ID_TO_TAG=1119325615393353819

# Interval polling (milidetik)
POLL_INTERVAL_MS=20000
